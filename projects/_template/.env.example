# ─── Anthropic ──────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# Модели (актуальные на 2026-06)
MODEL_THINKING=claude-opus-4-7
MODEL_WORKING=claude-sonnet-4-6
MODEL_CHEAP=claude-haiku-4-5
MODEL_REFLECTION=claude-haiku-4-5

# Anthropic proxy (для РФ-инфры через прокси)
ANTHROPIC_PROXY_URL=

# ─── Telegram ───────────────────────────────────────────────
# 5 ботов: Chief of Staff, Designer, CTO, Dev (общий backend/frontend), Research (общий researcher/strategist/curator)
TG_BOT_TOKEN_CHIEF=
TG_BOT_TOKEN_DESIGNER=
TG_BOT_TOKEN_CTO=
TG_BOT_TOKEN_DEV=
TG_BOT_TOKEN_RESEARCH=

TG_GROUP_ID=
TG_ALLOWED_USERS=

# ID топиков супергруппы
TG_TOPIC_BRIEFING=
TG_TOPIC_DECISIONS=
TG_TOPIC_RESEARCH=
TG_TOPIC_STRATEGY=
TG_TOPIC_DESIGN=
TG_TOPIC_ENGINEERING=
TG_TOPIC_SKILLS=
TG_TOPIC_GENERAL=

# ─── Database ───────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://exec_team:strongpassword@db:5432/exec_team
DB_PASSWORD=strongpassword

# ─── Redis ──────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── GitHub ─────────────────────────────────────────────────
GITHUB_TOKEN=
GITHUB_USER=
PRODUCT_REPO=

# ─── Project ────────────────────────────────────────────────
CURRENT_PROJECT_SLUG=moy-kosmetolog

# ─── Budget ─────────────────────────────────────────────────
MONTHLY_TEAM_BUDGET_USD=150
HARD_STOP_THRESHOLD_PCT=80
DEFAULT_FEATURE_BUDGET_CAP_CENTS=500
DEFAULT_THREAD_BUDGET_CAP_CENTS=100

# ─── Agentic caps ───────────────────────────────────────────
# Сколько итераций tool-use loop разрешено для одного агентского вызова
AGENTIC_MAX_ITERATIONS_DESIGNER=20
AGENTIC_MAX_ITERATIONS_CTO=20
AGENTIC_MAX_ITERATIONS_RESEARCHER=20
AGENTIC_MAX_ITERATIONS_STRATEGIST=20
AGENTIC_MAX_ITERATIONS_CHIEF=5
AGENTIC_MAX_ITERATIONS_CURATOR=10

# ─── Sandbox для dev-агентов ────────────────────────────────
SANDBOX_IMAGE=executive-ai-team-dev-sandbox:latest
SANDBOX_WORKSPACE=/var/exec-team-workspace
SANDBOX_TIMEOUT_SECONDS=3600
SANDBOX_CLAUDE_CODE_MAX_TURNS=50
SANDBOX_CLAUDE_MODEL=claude-sonnet-4-6

# ─── Anthropic API настройки ────────────────────────────────
ANTHROPIC_TIMEOUT_SECONDS=900
ANTHROPIC_MAX_RETRIES=3
PROMPT_CACHE_ENABLED=true

# ─── Toggles ────────────────────────────────────────────────
NL_ROUTER_ENABLED=1
REFLECTION_ENABLED=1
RESEARCHER_AUTO_SCAN=0
CURATOR_AUTO_RUN=0

# ─── Thread Engine ──────────────────────────────────────────
THREAD_DEFAULT_MAX_ROUNDS=3
THREAD_DEFAULT_MAX_MESSAGES=8
THREAD_DEEP_MAX_ROUNDS=5
THREAD_DEEP_MAX_MESSAGES=15

# ─── Codebase access ────────────────────────────────────────
CODEBASE_SNAPSHOT_DIR=/var/exec-team-codebase-snapshot
CODEBASE_REFRESH_HOURS=6

# ─── Skills ─────────────────────────────────────────────────
SKILLS_ENABLED=true
SKILLS_DIR=/app/skills
